  "install": {
    "Mac": [
      {
        "text": "Unzip the download."
      },
      {
        "text": "In Finder, choose Go › Go to Folder and paste:",
        "code": "~/Library/Audio/Plug-Ins/VST3"
      },
      {
        "text": "Move DRiFT.vst3 into that folder."
      },
      {
        "text": "DRiFT isn't signed by Apple yet. To allow it, run this in Terminal:",
        "code": "xattr -dr com.apple.quarantine ~/Library/Audio/Plug-Ins/VST3/DRiFT.vst3"
      },
      {
        "text": "Rescan plugins in your DAW."
      }
    ],
    "Windows": [
      {
        "text": "Unzip the download."
      },
      {
        "text": "Move DRiFT.vst3 into:",
        "code": "C:\\Program Files\\Common Files\\VST3"
      },
      {
        "text": "Rescan plugins in your DAW."
      }
    ]
  }
